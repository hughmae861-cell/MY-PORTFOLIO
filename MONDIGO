<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MONDIGO</title>

    <style>
        /* GENERAL DESIGN */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: pink;
            color: #333;
            line-height: 1.6;
        }

        /* NAVIGATION */
        nav {
            background-color: pink;
            padding: 18px;
            display: flex;
            justify-content: center;
            gap: 25px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        nav a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        nav a:hover {
            color: pink;
        }

        /* HOME */
        header {
            background: linear-gradient(135deg, #4b277a, #9b72cf);
            color: white;
            text-align: center;
            padding: 60px 20px;
        }

        .profile-picture {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            border: 5px solid white;
            object-fit: cover;
            margin-bottom: 15px;
        }

        header h1 {
            font-size: 38px;
            margin-bottom: 10px;
        }

        header p {
            font-size: 18px;
        }

        /* SECTIONS */
        section {
            padding: 45px 10%;
            margin: 25px auto;
            max-width: 1100px;
            background-color: white;
            border-radius: 15px;
            box-shadow: 0 4px 12px #ddd;
        }

        h2 {
            color: #4b277a;
            font-size: 28px;
            margin-bottom: 20px;
            border-bottom: 3px solid #9b72cf;
            padding-bottom: 8px;
        }

        /* ABOUT ME */
        #about p {
            margin-bottom: 10px;
        }

        /* MY SKILLS */
        .skills-container {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }

        .skill {
            background-color: #eee3ff;
            color: #4b277a;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.3s;
        }

        .skill:hover {
            background-color: #4b277a;
            color: white;
            transform: translateY(-5px);
        }

        /* MY PROJECTS */
        .projects-container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .project-card {
            flex: 1 1 250px;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 20px;
            background-color: #faf7ff;
            transition: 0.3s;
        }

        .project-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px #ccc;
        }

        .project-card img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 10px;
        }

        .project-card h3 {
            color: #4b277a;
            margin-bottom: 8px;
        }

        /* CONTACT */
        #contact p {
            margin: 10px 0;
        }

        #contact a {
            color: #6b3fa0;
            text-decoration: none;
        }

        #contact a:hover {
            text-decoration: underline;
        }

        /* FOOTER */
        footer {
            background-color: #4b277a;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 30px;
        }

        /* MOBILE RESPONSIVE */
        @media (max-width: 600px) {
            nav {
                gap: 12px;
                flex-wrap: wrap;
            }

            header h1 {
                font-size: 28px;
            }

            section {
                padding: 25px 6%;
                margin: 15px;
            }
        }
    </style>
</head>

<body>

